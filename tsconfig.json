{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@msqdx/ui": [
        "./lib/msqdx-ui.ts"
      ],
      "@msqdx/ui-shell": [
        "./lib/msqdx-ui-shell.ts"
      ],
      "@msqdx/tokens": [
        "./lib/msqdx-tokens-shim.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "__tests__",
    "**/*.test.ts",
    "**/*.test.tsx",
    "msqdx-design-system/packages/figma-plugin",
    "**/figma-plugin/**",
    "msqdx-design-system/**/storybook*",
    "**/storybook/**",
    "**/.storybook/**",
    "**/*.stories.ts",
    "**/*.stories.tsx"
  ]
}