{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@msqdx/react": [
        "../msqdx-design-system/packages/react/src/index.ts",
        "./node_modules/@msqdx/react"
      ],
      "@msqdx/tokens": [
        "../msqdx-design-system/packages/tokens/src/index.ts",
        "./node_modules/@msqdx/tokens"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "msqdx-design-system/packages/figma-plugin",
    "**/figma-plugin/**",
    "msqdx-design-system/**/storybook*",
    "**/storybook/**",
    "**/.storybook/**",
    "**/*.stories.ts",
    "**/*.stories.tsx"
  ]
}