# NextAuth (required in production)
AUTH_SECRET=your-secret-at-least-32-characters-long

# PostgreSQL (for user storage and registration). Run `npm run db:push` to create tables.
# DATABASE_URL=postgresql://user:password@host:5432/plexon

# Optional: demo login when DATABASE_URL is not set
# PLEXON_DEMO_EMAIL=demo@plexon.local
# PLEXON_DEMO_PASSWORD=demo

# Admin-Rolle: E-Mail, die beim Login automatisch als Admin gesetzt wird (einmalig).
# PLEXON_ADMIN_EMAIL=admin@example.com

# MSQDX Design System path. Default: ../msqdx-design-system (so .../packages/react and .../packages/tokens exist).
# If your DS is under MSQDX-DS, set e.g. DS_BASE=../MSQDX-DS/msqdx-design-system
# DS_BASE=../msqdx-design-system

# Board: complete prompts with Claude. Optional; without ANTHROPIC_API_KEY, board submit will fail.
# ANTHROPIC_API_KEY=sk-ant-...
# Model: default is Sonnet 4 (good for MCP tools). Override for Haiku: ANTHROPIC_BOARD_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_BOARD_MODEL=claude-sonnet-4-20250514

# CHECKION REST (Assistant workflows: scan, research, GEO, projects). Required for Phase-2 playbooks.
# CHECKION_API_URL=https://checkion.example.com
# CHECKION_API_TOKEN=checkion_xxxxxxxx…  # User API token from CHECKION → Settings → API access (alias: CHECKION_SERVICE_TOKEN)
# Must be set on the PLEXON container — not only on the CHECKION MCP service.

# CHECKION admin API (dashboard: list/edit/delete CHECKION users). Optional; separate from CHECKION_API_TOKEN.
# CHECKION_ADMIN_API_KEY=your-checkion-admin-api-key-min-16-chars

# Zentrale Auth für CHECKION/AUDION: Services rufen beim Login diese API auf.
# Gemeinsamer Secret (min. 16 Zeichen). In PLEXON und in jedem Service setzen.
# PLEXON_SERVICE_SECRET=your-shared-secret-min-16-chars

# Einmalige Migration CHECKION → PLEXON users (manual only; never set in Coolify for auto-run):
# DATABASE_URL = PLEXON-DB, MIGRATION_SOURCE_DATABASE_URL = CHECKION-DB, then: npm run migrate:checkion-users
# Does not overwrite existing PLEXON password_hash on conflict.

# External product entry points (used on dashboard teaser boxes / Products registry).
# NEXT_PUBLIC_AUDION_ADMIN_URL=https://audion-v3.projects-a.plygrnd.tech/
# NEXT_PUBLIC_CHECKION_URL=https://checkion-v3.projects-a.plygrnd.tech
# NEXT_PUBLIC_BRANDION_URL=https://brandion-v3.projects-a.plygrnd.tech
# NEXT_PUBLIC_VIDEON_URL=

# --- Password reset: SMTP (optional) or Mailgun HTTP API ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-smtp-app-password
# Optional for port 465: SMTP_SECURE=true
# PLEXON_PASSWORD_RESET_FROM_EMAIL=PLEXON <noreply@example.com>
# NEXTAUTH_URL=https://plexon.example.com

# If you do NOT use SMTP: Mailgun (private API key + sending domain from Mailgun dashboard).
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=mg.example.com
# Aliases: MG_API_KEY / MAILGUN_PRIVATE_API_KEY; MAILGUN_SENDING_DOMAIN / MG_DOMAIN
# EU region: MAILGUN_REGION=eu  (or MAILGUN_EU=1)
# Or set full host: MAILGUN_API_BASE_URL=https://api.eu.mailgun.net
# Rare: MAILGUN_BASIC_USERNAME=api (default)
